# Copy to devices.local.env and fill in for your own rig. That file is gitignored and is
# the ONLY place real identity belongs; devices.env is tracked and must stay portable.
#
# Every value here is a placeholder chosen to be structurally valid but impossible to
# reach: a rig that silently ran against these would be a worse failure than one that
# refuses to start, which is why devices.env asserts each of them rather than defaulting.
#
# Scalars use ${VAR:-value} so an explicit environment override still wins, matching the
# rest of devices.env. This is NOT the empty-default shape that has burned this rig: the
# fallback here is a real value, and devices.env still asserts each name with ${VAR:?} so
# a name missing from this file stops the run rather than reading as absent.

# The phone, as usbmux reports it. Hyphenated; comparisons strip hyphens from both sides.
PHONE_UDID="${PHONE_UDID:-00008140-AAAABBBBCCCCDDDD}"

# Home Assistant's WebSocket API. The harness disables a config entry here to release the
# device's single BLE link, so this must be the instance that actually owns the light.
# .invalid is reserved by RFC 2606 and can never resolve, so an unedited copy fails fast.
HA_WEBSOCKET_URL="${HA_WEBSOCKET_URL:-wss://ha.example.invalid:8123/api/websocket}"

# Apple Developer team that signs the WebDriverAgent runner, ten characters.
APPLE_TEAM_ID="${APPLE_TEAM_ID:-ABCDE12345}"

# Bundle id of the signed WebDriverAgent runner, which follows your team's App ID.
WDA_RUNNER_BUNDLE_ID="${WDA_RUNNER_BUNDLE_ID:-com.example.WebDriverAgentRunner.xctrunner}"

# The device table. Keys are your own labels and are used as the argument to up.sh.
declare -A DEVICE_HA_ENTRY=(
  [strip]=01JAAAAAAAAAAAAAAAAAAAAAAA
  [lounge]=01JBBBBBBBBBBBBBBBBBBBBBBB
  [tv]=01JCCCCCCCCCCCCCCCCCCCCCCC
)
declare -A DEVICE_MODEL=(
  [strip]=H617A
  [lounge]=H617A
  [tv]=H6199
)
# Only a model the harness may drive DIRECTLY carries an address. An app-sniff-only device
# must be omitted here so direct mode refuses it: absence is the refusal, so adding an
# address to a device you only mean to sniff silently grants direct control.
# D0:35:34 is Govee's OUI, so this stays recognisable as a Govee address while being fake.
declare -A DEVICE_BLE_ADDRESS=(
  [strip]=D0:35:34:AA:BB:CC
)
DEVICE_DEFAULT="${DEVICE_DEFAULT:-strip}"
