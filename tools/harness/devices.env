# Sourced by every harness script. One place for machine paths and device identity.
#
# The public workflow stays in Bash. On the lab, phone and BLE operations are native Linux.
# On WSL, UI/direct work uses Windows while app capture transfers the iPhone to native Linux;
# Bash still owns orchestration, decoding, Home Assistant handover and tests.
#
# IDENTITY IS NOT IN THIS FILE. This file is tracked and public; the phone UDID, the Home
# Assistant endpoint and entry ids, the Apple team and the BLE addresses all live in an
# untracked devices.local.env. Copy devices.local.env.example and fill it in.

HARNESS_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HARNESS_IDENTITY_FILE="${HARNESS_IDENTITY_FILE:-$HARNESS_SELF_DIR/devices.local.env}"
if [ ! -r "$HARNESS_IDENTITY_FILE" ]; then
  echo "no identity file at $HARNESS_IDENTITY_FILE" >&2
  echo "cp $HARNESS_SELF_DIR/devices.local.env.example $HARNESS_SELF_DIR/devices.local.env and edit it" >&2
  return 1 2>/dev/null || exit 1
fi
# shellcheck source=/dev/null
# set -a so the identity reaches child processes. Nothing here was exported before, which
# went unnoticed only because ha_entry.py and wda_daemon.py each carried a baked-in copy of
# the value they needed: the environment path was dead code that appeared to work.
set -a
source "$HARNESS_IDENTITY_FILE"
set +a

# ASSERT, NEVER DEFAULT. Every one of these used to carry a ${VAR:-<real value>} default,
# which is the single bug shape that has cost this rig the most time: a lookup that fails
# reads as a value that is absent, and the run continues against the wrong thing or against
# nothing at all. ${VAR:?} makes a missing value stop the shell where it is missing.
: "${PHONE_UDID:?set in $HARNESS_IDENTITY_FILE}"
: "${HA_WEBSOCKET_URL:?set in $HARNESS_IDENTITY_FILE}"
: "${DEVICE_DEFAULT:?set in $HARNESS_IDENTITY_FILE}"
if [ "${#DEVICE_HA_ENTRY[@]}" -eq 0 ] || [ "${#DEVICE_MODEL[@]}" -eq 0 ]; then
  echo "$HARNESS_IDENTITY_FILE defines no devices" >&2
  return 1 2>/dev/null || exit 1
fi

# A SNIFF ADDRESS IS NOT A CONNECT ADDRESS. An app-sniff-only device is kept out of
# DEVICE_BLE_ADDRESS so direct mode refuses it, and up.sh's refusal is literally the
# absence of a value. But a capture still has to be attributable: a phone stays paired
# with every light in the house, so an H6199 capture that nobody filtered reads exactly
# like a session with one device in it, and an H617A frame in it would become an H6199
# finding. DEVICE_SNIFF_ADDRESS carries the address for that one purpose.
#
# The two asserts below keep the structural safety rather than replacing it with a rule
# somebody has to remember: the same device may not appear in both maps, and no sniff
# value may appear anywhere in DEVICE_BLE_ADDRESS. resolve_device never assigns a sniff
# value to DEVICE_ADDRESS, so there is no path from this map to something that connects.
declare -p DEVICE_SNIFF_ADDRESS >/dev/null 2>&1 || declare -A DEVICE_SNIFF_ADDRESS=()
for _sniff_device in "${!DEVICE_SNIFF_ADDRESS[@]}"; do
  if [ -n "${DEVICE_BLE_ADDRESS[$_sniff_device]:-}" ]; then
    echo "$_sniff_device is in both DEVICE_BLE_ADDRESS and DEVICE_SNIFF_ADDRESS" >&2
    echo "a sniff-only device must have no connect address; pick one map" >&2
    return 1 2>/dev/null || exit 1
  fi
  for _connect_device in "${!DEVICE_BLE_ADDRESS[@]}"; do
    if [ "${DEVICE_BLE_ADDRESS[$_connect_device]}" = "${DEVICE_SNIFF_ADDRESS[$_sniff_device]}" ]; then
      echo "the sniff address for $_sniff_device is also $_connect_device's connect address" >&2
      return 1 2>/dev/null || exit 1
    fi
  done
done
unset _sniff_device _connect_device

BWS_PLATFORM_HELPER="${BWS_PLATFORM_HELPER:-$HOME/.copilot/skills/platform/scripts/platform-bws.sh}"

GOVEE_APP_BUNDLE=com.ihoment.GoVeeSensor
GOVEE_APP_PROCESS=GoveeHome

harness_host_kind() {
  if [ -n "${HARNESS_HOST_KIND:-}" ]; then
    echo "$HARNESS_HOST_KIND"
  elif grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
    echo wsl
  elif command -v with-host-bluetooth >/dev/null 2>&1; then
    echo lab
  else
    echo linux
  fi
}
HARNESS_HOST_KIND="$(harness_host_kind)"
# Whether the CALLER pinned the backend, recorded before the default is applied. Backend
# overrides redefine functions and cannot be unloaded, so phone.sh may only load them at
# source time when the answer is already final; otherwise resolve_device loads them.
HARNESS_PHONE_BACKEND_EXPLICIT="${HARNESS_PHONE_BACKEND+1}"
# Same reason, for the two paths that follow from the backend. Recorded here so the
# derivation below can run twice without a second run being unable to tell its own first
# answer from an operator's choice.
GOVEE_CAPTURE_DIR_EXPLICIT="${GOVEE_CAPTURE_DIR+1}"
GOVEE_SHOT_DIR_EXPLICIT="${GOVEE_SHOT_DIR+1}"
HARNESS_PHONE_BACKEND="${HARNESS_PHONE_BACKEND:-$([ "$HARNESS_HOST_KIND" = wsl ] && echo windows || echo native)}"
HARNESS_BLE_BACKEND="${HARNESS_BLE_BACKEND:-$([ "$HARNESS_HOST_KIND" = wsl ] && echo windows || echo native)}"

# Everything that follows from WHO OWNS THE PHONE, in one function because it has to run
# twice: once from the ambient defaults above, and again after resolve_device adopts the
# ownership an already-running session recorded. Deriving it only once was the bug behind a
# whole class of silent failure, because the ambient default on WSL is `windows` and every
# app session overrides it to `native` in up.sh's process alone.
harness_derive_backend_env() {
  # App captures on WSL attach the phone to native Linux usbmuxd. Every library and CLI call
  # in that ownership mode must use its Unix socket rather than Windows iTunes.
  #
  # This is not belt-and-braces. pymobiledevice3 ships a Wsl class whose usbmux_address is the
  # Windows iTunes TCP endpoint, so WITHOUT this every usbmux call on this rig fails with
  # "Failed to connect to usbmuxd socket" while the daemon is running and healthy. That reads
  # as a dead phone, and the capture preflight even tells you to go and check it.
  if [ "$HARNESS_PHONE_BACKEND" = native ] && [ "$HARNESS_HOST_KIND" = wsl ]; then
    USBMUXD_SOCKET_ADDRESS="${USBMUXD_SOCKET_ADDRESS:-/var/run/usbmuxd}"
    export USBMUXD_SOCKET_ADDRESS
    # Same condition, same reason, so it lives beside it rather than in up.sh: the
    # pymobiledevice3 capture backend cannot reach a natively-owned phone, and its failure
    # surfaces as "no HCI frames", which points at Bluetooth profiles instead of at this.
    GOVEE_CAPTURE_BACKEND="${GOVEE_CAPTURE_BACKEND:-idevicebtlogger}"
    export GOVEE_CAPTURE_BACKEND
  fi

  # iOS 17.4+ exposes CoreDeviceProxy over usbmuxd, so a WSL app session keeps every developer
  # service in the process that opened its userspace RSD tunnel. A shared native tunneld does not
  # discover this phone reliably after USB/IP ownership changes.
  if [ -z "${HARNESS_RSD_BACKEND+x}" ]; then
    if [ "$HARNESS_PHONE_BACKEND" = native ] && [ "$HARNESS_HOST_KIND" = wsl ]; then
      HARNESS_RSD_BACKEND=userspace
    else
      HARNESS_RSD_BACKEND=tunneld
    fi
  fi
  export HARNESS_RSD_BACKEND

  # WHERE A SESSION'S EVIDENCE LIVES follows from who owns the phone, so it is derived here
  # and not at source time. The Windows backend writes under the shared Z: tool directory and
  # the native one under $HOME, and these are different filesystems, not two names for one
  # place. Deciding this before the backend was known is what made a shell that had not run
  # up.sh look in the Windows directory for a native session's capture: `act.sh` reported
  # "(no capture running)" and wrote its screenshots somewhere the evidence was not, which
  # reads as a capture that failed to start rather than as a shell looking in the wrong room.
  if [ -z "$GOVEE_CAPTURE_DIR_EXPLICIT" ]; then
    if [ "$HARNESS_PHONE_BACKEND" = windows ]; then
      GOVEE_CAPTURE_DIR="$WSL_WINDOWS_TOOL_DIR/captures"
    else
      GOVEE_CAPTURE_DIR="$HOME/govee-captures"
    fi
  fi
  [ -n "$GOVEE_SHOT_DIR_EXPLICIT" ] || GOVEE_SHOT_DIR="$GOVEE_CAPTURE_DIR/shots"
  export GOVEE_CAPTURE_DIR GOVEE_SHOT_DIR
}

if [ -z "${PYMOBILEDEVICE3+x}" ]; then
  PYMOBILEDEVICE3=pymobiledevice3
  PYMOBILEDEVICE3_IS_DEFAULT=1
else
  PYMOBILEDEVICE3_IS_DEFAULT=0
fi
# 10.2.3 is the iOS 27 mounter release: on iOS 27.0 LookupImage returns an empty
# ImageSignature for a Personalized DDI that IS mounted, so the pre-mount check missed it
# and re-ran the whole upload. It now falls back to CopyDevices and bails out BEFORE the TSS
# request and image upload. That matters more here than anywhere else, because the upload is
# the one operation USB/IP is known to break (usbipd-win#867, "by design, cannot be fixed").
NATIVE_PMD3_TOOL="${NATIVE_PMD3_TOOL:-pipx:pymobiledevice3@10.3.0}"
IDEVICEBTLOGGER="${IDEVICEBTLOGGER:-idevicebtlogger}"
IPHONE_USB_HARDWARE_ID="${IPHONE_USB_HARDWARE_ID:-05ac:12a8}"
USBIPD="${USBIPD:-usbipd.exe}"
BLUETOOTH_LOGGING_PROFILE_URL=https://secure-appldnld.apple.com/iOSProfiles/BluetoothLogging.mobileconfig
BLUETOOTH_LOGGING_PROFILE_UUID=D8A1D847-C161-4D0A-9426-FB9C3E48297D
export BLUETOOTH_LOGGING_PROFILE_URL BLUETOOTH_LOGGING_PROFILE_UUID
WINDOWS_TOOL_DIR="${WINDOWS_TOOL_DIR:-Z:\\libimobiledevice}"
WSL_WINDOWS_TOOL_DIR="${WSL_WINDOWS_TOOL_DIR:-/mnt/z/libimobiledevice}"
WINDOWS_PMD3_PYTHON="${WINDOWS_PMD3_PYTHON:-$WSL_WINDOWS_TOOL_DIR/.venv-pmd3/Scripts/python.exe}"
WINDOWS_CLIENT_PYTHON="${WINDOWS_CLIENT_PYTHON:-$WSL_WINDOWS_TOOL_DIR/.venv/Scripts/python.exe}"
# The lab LXC borrows host BlueZ. WSL and ordinary Linux own a controller and run directly.
if [ "$HARNESS_BLE_BACKEND" = windows ]; then
  WITH_HOST_BLUETOOTH=
elif [ -z "${WITH_HOST_BLUETOOTH+x}" ]; then
  if command -v with-host-bluetooth >/dev/null 2>&1; then
    WITH_HOST_BLUETOOTH=with-host-bluetooth
  else
    WITH_HOST_BLUETOOTH=
  fi
fi

# Called only now, because it derives the capture paths and those need the Windows tool
# directory above. Runs again from resolve_device once a running session's ownership is
# adopted; everything it sets is derived, so the second run supersedes the first cleanly.
harness_derive_backend_env

# dvt screenshot returns the panel at this resolution and universal-hid-service takes
# 0..65535 on both axes, so a screenshot pixel converts by straight-line scale with no
# offset. Re-derive with the tap oracle if the phone or iOS version changes.
PHONE_PANEL_WIDTH=1206
PHONE_PANEL_HEIGHT=2622
SHOT_SCALE=0.35

# Gestures go through a PERSISTENT serve-web session, not a process per gesture. See
# hid_up in phone.sh for the measurement that forced this.
SERVE_WEB_PORT=8080
TUNNELD_PORT=49151
# WebDriverAgent's own port on the device, forwarded to the same number locally.
WDA_PORT=8100
# Whether the CALLER pinned these, recorded before any default is applied. resolve_device
# derives per-device paths below, and it must not overwrite an explicit choice; once a value
# is assigned there is no other way to tell the two apart.
HARNESS_STATE_FILE_EXPLICIT="${HARNESS_STATE_FILE+1}"
HARNESS_RUN_DIR_EXPLICIT="${HARNESS_RUN_DIR+1}"
# One prefix, so the per-device path and the "which session is up?" glob cannot drift apart.
HARNESS_STATE_PREFIX="${HARNESS_STATE_PREFIX:-/tmp/govee-harness-state}"
HARNESS_STATE_FILE="${HARNESS_STATE_FILE:-/tmp/govee-harness-state}"
HARNESS_RUN_DIR="${HARNESS_RUN_DIR:-/tmp/govee-harness}"

# Which device the running session is for, so a tool that takes no device argument can still
# reconstruct it. Fails when none or several are up, because guessing which light a gesture
# is aimed at is the silent wrong answer.
harness_running_session_device() {
  local file candidates=() mode device
  for file in "$HARNESS_STATE_PREFIX"-*; do
    [ -s "$file" ] && candidates+=("$file")
  done
  [ "${#candidates[@]}" = 1 ] || return 1
  read -r mode device _ <"${candidates[0]}" || return 1
  [ -n "$device" ] || return 1
  echo "$device"
}
PHONE_USBIPD_STATE_FILE="${PHONE_USBIPD_STATE_FILE:-$HARNESS_RUN_DIR/iphone-usbipd.state}"
USBIPD_WAIT_ATTEMPTS="${USBIPD_WAIT_ATTEMPTS:-12}"
USBIPD_WAIT_DELAY="${USBIPD_WAIT_DELAY:-0.5}"
USBIPD_ATTACH_ATTEMPTS="${USBIPD_ATTACH_ATTEMPTS:-3}"

# The address the PHONE must use to reach a service we host. The phone is on USB but its
# HTTP traffic goes over the LAN, so this is the lab's own routable address, not a loopback.
# Derived, so a re-addressed guest does not silently break every gesture.
harness_host_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null |
    awk '{ for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1) }' | head -1
}

resolve_device() {
  local requested="${1:-$DEVICE_DEFAULT}"
  if [ -z "${DEVICE_HA_ENTRY[$requested]:-}" ]; then
    echo "unknown device '$requested'; known: ${!DEVICE_HA_ENTRY[*]}" >&2
    return 1
  fi
  DEVICE_NAME="$requested"
  DEVICE_ENTRY="${DEVICE_HA_ENTRY[$requested]}"
  DEVICE_SKU="${DEVICE_MODEL[$requested]}"
  DEVICE_ADDRESS="${DEVICE_BLE_ADDRESS[$requested]:-}"
  # Read separately and never merged into DEVICE_ADDRESS. Direct mode tests DEVICE_ADDRESS,
  # so a sniff-only device stays unreachable by construction rather than by convention.
  DEVICE_SNIFF_ADDR="${DEVICE_SNIFF_ADDRESS[$requested]:-}"
  # The address a capture of this device must contain, whichever way we drove it. Zero
  # frames from it is a failed session, not a quiet one: see capture_holds_expected_peer.
  DEVICE_EXPECTED_PEER="${DEVICE_ADDRESS:-$DEVICE_SNIFF_ADDR}"

  # A session belongs to a DEVICE, so its paths are derived from the device name rather than
  # inherited from whichever shell ran up.sh. They used to be inherited, which meant a shell
  # that had not run up.sh could not find a running session at all: down.sh read the absent
  # unsuffixed state file, concluded `direct`, and tore down an app session without stopping
  # its capture or its WDA runner. The same blindness made a fresh shell start captures on a
  # backend that cannot reach a natively-owned phone.
  [ -n "$HARNESS_STATE_FILE_EXPLICIT" ] ||
    HARNESS_STATE_FILE="$HARNESS_STATE_PREFIX-$DEVICE_NAME"
  [ -n "$HARNESS_RUN_DIR_EXPLICIT" ] || HARNESS_RUN_DIR="/tmp/govee-harness-$DEVICE_NAME"
  export HARNESS_STATE_FILE HARNESS_RUN_DIR
  PHONE_USBIPD_STATE_FILE="$HARNESS_RUN_DIR/iphone-usbipd.state"
  mkdir -p "$HARNESS_RUN_DIR"

  # Adopt the ownership a running session recorded, then re-derive everything that follows
  # from it. up.sh already writes these fields; nothing read them back, so every later shell
  # silently fell back to the ambient WSL default of `windows`.
  if [ -s "$HARNESS_STATE_FILE" ]; then
    local _mode _dev _entry _phone _rsd
    read -r _mode _dev _entry _phone _rsd <"$HARNESS_STATE_FILE" || true
    [ -z "$_phone" ] || export HARNESS_PHONE_BACKEND="$_phone"
    [ -z "$_rsd" ] || export HARNESS_RSD_BACKEND="$_rsd"
    harness_derive_backend_env
    # The CLI choice follows HARNESS_RSD_BACKEND, which only just became final.
    declare -F harness_resolve_pmd3 >/dev/null && harness_resolve_pmd3
  fi
  # Now the backend is final, so any function overrides it implies can safely be loaded.
  declare -F harness_load_backend_overrides >/dev/null && harness_load_backend_overrides
}
