# aa 12 wake timer, shared govee_common::wake_timer.
id: status_reply_wake_timer
data: status_reply_wake_timer.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 18
  - actual: body.enabled
    expected: 0
  - actual: body.end_brightness
    expected: 100
  - actual: body.hour
    expected: 17
  - actual: body.minute
    expected: 1
  - actual: body.repeat
    expected: 0
  - actual: body.duration_minutes
    expected: 29
