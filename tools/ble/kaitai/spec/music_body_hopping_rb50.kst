# Hopping with rel_brightness at the documented 0x32 cap; the other Hopping body sits one
# below at 0x31.
id: music_body_hopping_rb50
data: music_body_hopping_rb50.bin
imports:
  - music_body
asserts:
  - actual: mode
    expected: 51
  - actual: count
    expected: 7
  - actual: palette.size
    expected: 7
  - actual: tail_len
    expected: 9
  - actual: tail.background.r
    expected: 255
  - actual: tail.background.g
    expected: 0
  - actual: tail.background.b
    expected: 0
  - actual: tail.rel_brightness
    expected: 50
  - actual: tail.fixed
    expected: "6201030206"
