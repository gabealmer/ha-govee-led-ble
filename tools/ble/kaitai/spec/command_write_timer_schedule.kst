# Schedule slot 0, enable_and_type 0x81: enabled with the on-action bit set.
id: command_write_timer_schedule
data: command_write_timer_schedule.bin
imports:
  - command_write
asserts:
  - actual: body.index
    expected: 0
  - actual: body.slot.enable_and_type
    expected: 129
  - actual: body.slot.hour
    expected: 7
  - actual: body.slot.minute
    expected: 30
  - actual: body.slot.repeat
    expected: 192
