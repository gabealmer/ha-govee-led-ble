# Per-segment brightness, static_sub 0x02, a different body shape from the colour cases.
# Mask 0x007f selects segments 1..7.
id: command_write_seg_brightness
data: command_write_seg_brightness.bin
imports:
  - command_write
asserts:
  - actual: body.sub
    expected: 21
  - actual: body.sub_body.static_sub
    expected: 2
  - actual: body.sub_body.static_body.percent
    expected: 17
  - actual: body.sub_body.static_body.mask.bits
    expected: 127
