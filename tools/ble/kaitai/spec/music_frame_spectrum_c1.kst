# A simple mode carrying a manual colour. Every param mode ships count 0 and puts its
# palette in the 0x41 A3 body instead, which is what separates the two families.
id: music_frame_spectrum_c1
data: music_frame_spectrum_c1.bin
imports:
  - music_body
type: mode_set_frame
asserts:
  - actual: mode
    expected: 4
  - actual: sensitivity
    expected: 99
  - actual: style
    expected: 0
  - actual: count
    expected: 1
  - actual: colors.size
    expected: 1
  - actual: colors[0].r
    expected: 255
  - actual: colors[0].g
    expected: 0
  - actual: colors[0].b
    expected: 0
