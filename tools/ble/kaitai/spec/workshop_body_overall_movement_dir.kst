# Overall movement packed 0x12: the same direction 2 as the selected-area case above but
# with the enter-exit bit clear, which is what separates the two bits.
id: workshop_body_overall_movement_dir
data: workshop_body_overall_movement_dir.bin
imports:
  - workshop_body
asserts:
  - actual: header.linecount
    expected: 4
  - actual: layer_count
    expected: 2
  - actual: layers.size
    expected: 2
  - actual: layers[0].record_len
    expected: 29
  - actual: layers[0].body.colour_count
    expected: 2
  - actual: layers[0].body.palette.size
    expected: 2
  - actual: layers[0].body.excess.size
    expected: 0
  - actual: layers[1].record_len
    expected: 26
  - actual: layers[1].body.colour_count
    expected: 1
  - actual: layers[1].body.palette.size
    expected: 1
  - actual: layers[1].body.excess.size
    expected: 0
  - actual: layers[0].body.overall_movement.packed
    expected: 18
  - actual: layers[0].body.overall_movement.enabled
    expected: true
  - actual: layers[0].body.overall_movement.enter_exit_effect
    expected: false
  - actual: layers[0].body.overall_movement.direction
    expected: 2
  - actual: layers[0].body.priority
    expected: 0
