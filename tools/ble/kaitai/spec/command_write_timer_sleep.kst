# Sleep timer: enabled, ramp from 50 per cent, 16 minutes to close.
id: command_write_timer_sleep
data: command_write_timer_sleep.bin
imports:
  - command_write
asserts:
  - actual: body.enabled
    expected: 1
  - actual: body.start_brightness
    expected: 50
  - actual: body.close_minutes
    expected: 16
  - actual: body.current_minutes
    expected: 16
