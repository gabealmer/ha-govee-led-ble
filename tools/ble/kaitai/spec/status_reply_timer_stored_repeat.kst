# Read back moments after writing repeat 0x95 to slot 2 (2026-07-27). Slot 2 reads
# 01 00 00 95, byte-identical to the write, which is what proves the DEVICE stores the
# repeat byte rather than the app remembering it. Compare with the table above, where the
# same slot reads 0x80.
id: status_reply_timer_stored_repeat
data: status_reply_timer_stored_repeat.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 35
  - actual: body.slots[2].enable_and_type
    expected: 1
  - actual: body.slots[2].hour
    expected: 0
  - actual: body.slots[2].minute
    expected: 0
  - actual: body.slots[2].repeat
    expected: 149
