# H6199 effect definition uploaded over 0xA3, captured 2026-08-05 from the Govee Home
# iOS app driving the DreamView T1. The one-layer Workshop effect "Hey There" re-applied
# after the Brightness Scope range slider's lower handle dragged alone, taking the label from 0% to 35%. Each fixture in this chain differs from the one before at a single byte.
id: h6199_effect_workshop_scope_low
data: h6199_effect_workshop_scope_low.bin
imports:
  - h6199_effect_upload
asserts:
  - actual: kind
    expected: 2
  - actual: content.blocks[0].len
    expected: 29
  - actual: content.blocks[0].brightness_scope_low
    expected: "5b"
  - actual: content.blocks[0].brightness_change_speed
    expected: "ed"
  - actual: content.blocks[0].retention_time_brightest
    expected: "9a"
  - actual: content.blocks[0].retention_time_darkest
    expected: "c3"
