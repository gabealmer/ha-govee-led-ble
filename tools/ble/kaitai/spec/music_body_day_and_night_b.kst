# Day and Night with a non-zero third tail byte. One capture alone leaves that byte zero
# and makes the region look 2 bytes wide; this one proves it is 3. Per-mode tail lengths
# must be taken from the largest block seen across ALL captures, never from one.
id: music_body_day_and_night_b
data: music_body_day_and_night_b.bin
imports:
  - music_body
asserts:
  - actual: mode
    expected: 55
  - actual: count
    expected: 7
  - actual: palette.size
    expected: 7
  - actual: tail_len
    expected: 3
  - actual: tail.segment_count
    expected: 2
  - actual: tail.speed
    expected: 44
  - actual: tail.gradient
    expected: 1
