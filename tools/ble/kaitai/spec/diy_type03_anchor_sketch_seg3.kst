# Sketch, one group of three segments. Extracted from a capture no longer in the archive.
id: diy_type03_anchor_sketch_seg3
data: diy_type03_anchor_sketch_seg3.bin
imports:
  - diy_type03
asserts:
  - actual: header.linecount
    expected: 2
  - actual: effect
    expected: 9
  - actual: speed
    expected: 51
  - actual: brightness
    expected: 100
  - actual: background.r
    expected: 255
  - actual: background.g
    expected: 255
  - actual: background.b
    expected: 255
  - actual: group_count
    expected: 1
  - actual: groups.size
    expected: 1
  - actual: groups[0].seg_count
    expected: 3
  - actual: groups[0].segment_indices.size
    expected: 3
