# Connect-time clock write. 10:2b:10 is 16:43:16, weekday 4 = Thursday with Mon=1.
id: command_write_clock
data: command_write_clock.bin
imports:
  - command_write
asserts:
  - actual: body.hour
    expected: 16
  - actual: body.minute
    expected: 43
  - actual: body.second
    expected: 16
  - actual: body.weekday
    expected: 4
  - actual: body.flag1
    expected: 1
  - actual: body.utc_offset_hours
    expected: 10
  - actual: body.utc_offset_minutes
    expected: 0
