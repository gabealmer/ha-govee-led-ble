# Aurora at the fast speed step. Differs from the slow body only inside record data, never in the framing.
id: scene_body_aurora_fast
data: scene_body_aurora_fast.bin
imports:
  - scene_body
asserts:
  - actual: scene_type
    expected: 2
  - actual: record_count
    expected: 2
  - actual: records.size
    expected: 2
  - actual: padding.size
    expected: 12
  - actual: records[0].rec_len
    expected: 32
  - actual: records[0].body.select_type
    expected: 0
  - actual: records[0].body.colour_count
    expected: 3
  - actual: records[0].body.excess.size
    expected: 0
  - actual: records[1].rec_len
    expected: 35
  - actual: records[1].body.select_type
    expected: 0
  - actual: records[1].body.colour_count
    expected: 4
  - actual: records[1].body.excess.size
    expected: 0
