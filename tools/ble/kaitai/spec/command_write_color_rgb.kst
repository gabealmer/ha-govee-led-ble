# Whole-strip static colour. The unified static_color layout: rgb_direct carries the
# colour, kelvin and the preview triple are zeroed, and the mask selects all 15 segments.
id: command_write_color_rgb
data: command_write_color_rgb.bin
imports:
  - command_write
asserts:
  - actual: body.sub
    expected: 21
  - actual: body.sub_body.static_sub
    expected: 1
  - actual: body.sub_body.static_body.rgb_direct.r
    expected: 255
  - actual: body.sub_body.static_body.rgb_direct.g
    expected: 0
  - actual: body.sub_body.static_body.rgb_direct.b
    expected: 0
  - actual: body.sub_body.static_body.kelvin
    expected: 0
  - actual: body.sub_body.static_body.rgb_preview.r
    expected: 0
  - actual: body.sub_body.static_body.rgb_preview.g
    expected: 0
  - actual: body.sub_body.static_body.rgb_preview.b
    expected: 0
  - actual: body.sub_body.static_body.mask.bits
    expected: 32767
