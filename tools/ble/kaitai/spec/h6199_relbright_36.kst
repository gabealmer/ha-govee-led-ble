# H6199 relative-brightness write, captured 2026-08-04 from the Govee Home iOS app driving the DreamView T1
# over BLE. The light was off Govee's cloud entirely, so the app could reach it by no path
# but this one. Taken by dragging the Relative Brightness sheet's slider with all four edges selected.
id: h6199_relbright_36
data: h6199_relbright_36.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 174
  - actual: body.unknown_head
    expected: 1
  - actual: body.edge_count
    expected: 4
  - actual: body.left_percent
    expected: 36
  - actual: body.top_percent
    expected: 36
  - actual: body.right_percent
    expected: 36
  - actual: body.bottom_percent
    expected: 36
  - actual: body.opaque_tail
    expected: "0000000000000000000000"
