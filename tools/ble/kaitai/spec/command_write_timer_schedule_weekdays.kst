# Slot 2, captured 2026-07-27 (h617a-timer-readback-2026-07-27). Carries repeat 0x95 =
# 0x80 | Mon,Wed,Fri, which pins the weekday bit order and falsifies reading bit 0x80 as
# "fire once": a one-shot timer cannot also name three days.
id: command_write_timer_schedule_weekdays
data: command_write_timer_schedule_weekdays.bin
imports:
  - command_write
asserts:
  - actual: body.index
    expected: 2
  - actual: body.slot.enable_and_type
    expected: 129
  - actual: body.slot.hour
    expected: 0
  - actual: body.slot.minute
    expected: 0
  - actual: body.slot.repeat
    expected: 149
