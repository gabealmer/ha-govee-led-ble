# Colour-mode read-back, DIY on an app-assigned slot id, type_byte 0x00.
id: status_reply_cm_diy
data: status_reply_cm_diy.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 5
  - actual: body.mode
    expected: 10
  - actual: body.mode_body.slot
    expected: 152
  - actual: body.mode_body.type_byte
    expected: 0
