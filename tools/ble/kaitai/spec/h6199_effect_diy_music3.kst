# H6199 DIY Music3, captured from the iOS editor with the default seven-colour palette.
id: h6199_effect_diy_music3
data: h6199_effect_diy_music3.bin
imports: [h6199_effect_upload]
asserts:
  - {actual: kind, expected: 4}
  - {actual: content.family, expected: 4}
  - {actual: content.variant, expected: 7}
  - {actual: content.speed, expected: 50}
  - {actual: content.palette_len, expected: 21}
  - {actual: content.palette.size, expected: 7}
