# The reassembled body of the provisioning sequence above, concatenated from its four data
# frames in index order. The network is INVENTED. This is the fixture that pins the field
# layout, and in particular that the body is 49 bytes rather than 47: the two trailing bytes
# were on the wire before they were understood and were briefly mistaken for padding, which
# is exactly why the frame count is four and not three.
id: h6199_wifi_body_fakenet
data: h6199_wifi_body_fakenet.bin
imports:
  - h6199_wifi_body
asserts:
  - actual: ssid_len
    expected: 7
  - actual: ssid
    expected: "FAKENET"
  - actual: password_len
    expected: 8
  - actual: run_mode
    expected: 0
  - actual: tz_hour
    expected: 10
  - actual: iot_version
    expected: 0
  - actual: tz_minute
    expected: 0
  - actual: api_len
    expected: 24
  - actual: api
    expected: "https://device.govee.com"
  - actual: matter_wifi_flag
    expected: 0
  - actual: security_type
    expected: 0
