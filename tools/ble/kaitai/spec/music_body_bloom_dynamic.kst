# Bloom with the Dynamic companion 0x50 against Calm 0x14 in the body above. fixed0 stays
# 0x0a across both, so that constant is independent of the style control.
id: music_body_bloom_dynamic
data: music_body_bloom_dynamic.bin
imports:
  - music_body
asserts:
  - actual: mode
    expected: 48
  - actual: count
    expected: 7
  - actual: palette.size
    expected: 7
  - actual: tail_len
    expected: 2
  - actual: tail.fixed0
    expected: 10
  - actual: tail.style_companion
    expected: 80
