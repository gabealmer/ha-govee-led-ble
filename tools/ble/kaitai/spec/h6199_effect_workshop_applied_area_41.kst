# Applied Area lower handle then moved from 0% to 10%, leaving the upper handle at 50%.
id: h6199_effect_workshop_applied_area_41
data: h6199_effect_workshop_applied_area_41.bin
imports: [h6199_effect_upload]
asserts:
  - {actual: "content.blocks[0].applied_area", expected: 65}
  - {actual: "content.blocks[0].applied_area_width_tenths", expected: 4}
  - {actual: "content.blocks[0].applied_area_start_tenths", expected: 1}
  - {actual: "content.blocks[0].excess.size", expected: 0}
