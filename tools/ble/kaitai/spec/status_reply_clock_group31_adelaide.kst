# Live direct read after the vendor app connected with the phone on Australia/Adelaide.
id: status_reply_clock_group31_adelaide
data: status_reply_clock_group31_adelaide.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 165
  - actual: body.group
    expected: 49
  - actual: body.clock.hour
    expected: 20
  - actual: body.clock.minute
    expected: 32
  - actual: body.clock.second
    expected: 36
  - actual: body.clock.weekday
    expected: 7
  - actual: body.clock.flag1
    expected: 1
