# H6199 music-mode write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE. One of three sensitivity levels set by dragging the app's own
# slider with the mode tile and the sound-pickup toggle untouched, so any pair of them
# isolates the sensitivity byte alone. The light was off Govee's cloud, so BLE was the
# only path to it.
id: h6199_music_sensitivity_26
data: h6199_music_sensitivity_26.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 19
  - actual: body.detail.mode
    expected: 5
  - actual: body.detail.sensitivity
    expected: 26
  - actual: body.detail.is_calm
    expected: 0
  - actual: body.detail.has_fixed_colour
    expected: 0
  - actual: body.detail.opaque_tail
    expected: "000000000000000000"
