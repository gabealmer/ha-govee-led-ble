# Sketch with nothing painted: group_count 0, the empty-body edge case. Extracted from a capture no longer in the archive.
id: diy_type03_anchor_sketch_nopaint
data: diy_type03_anchor_sketch_nopaint.bin
imports:
  - diy_type03
asserts:
  - actual: header.linecount
    expected: 2
  - actual: effect
    expected: 2
  - actual: speed
    expected: 51
  - actual: brightness
    expected: 100
  - actual: background.r
    expected: 255
  - actual: background.g
    expected: 255
  - actual: background.b
    expected: 255
  - actual: group_count
    expected: 0
  - actual: groups.size
    expected: 0
