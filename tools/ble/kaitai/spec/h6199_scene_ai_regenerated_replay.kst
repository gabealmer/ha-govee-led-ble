# Activation emitted by a later replay of the same regenerated response.
id: h6199_scene_ai_regenerated_replay
data: h6199_scene_ai_regenerated_replay.bin
imports: [h6199_command_write]
asserts:
  - {actual: opcode, expected: 5}
  - {actual: body.sub_mode, expected: 4}
  - {actual: body.detail.scene_id, expected: 167}
  - {actual: body.detail.scene_class, expected: 0}
