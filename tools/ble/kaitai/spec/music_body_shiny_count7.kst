# Shiny with a 7-colour palette carrying the same tail as the 5-colour body above, which
# is what shows the tail is positioned RELATIVE to the end of the palette rather than at a
# fixed offset.
id: music_body_shiny_count7
data: music_body_shiny_count7.bin
imports:
  - music_body
asserts:
  - actual: mode
    expected: 49
  - actual: count
    expected: 7
  - actual: palette.size
    expected: 7
  - actual: tail_len
    expected: 3
  - actual: tail.style_companion
    expected: "0564"
  - actual: tail.fixed2
    expected: 10
