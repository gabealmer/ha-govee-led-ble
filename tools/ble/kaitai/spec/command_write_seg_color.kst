# Per-segment colour. Same static_sub as the whole-strip case, so the ONLY thing making
# this a segment write is the mask: 0x7f80 selects segments 8..15. That is why the two
# cases have to be held together.
id: command_write_seg_color
data: command_write_seg_color.bin
imports:
  - command_write
asserts:
  - actual: body.sub
    expected: 21
  - actual: body.sub_body.static_sub
    expected: 1
  - actual: body.sub_body.static_body.rgb_direct.r
    expected: 0
  - actual: body.sub_body.static_body.rgb_direct.g
    expected: 255
  - actual: body.sub_body.static_body.rgb_direct.b
    expected: 0
  - actual: body.sub_body.static_body.kelvin
    expected: 0
  - actual: body.sub_body.static_body.mask.bits
    expected: 32640
