# Yellow at the floor, two equal channels.
id: music_stream_yellow_floor
data: music_stream_yellow_floor.bin
imports:
  - music_stream
asserts:
  - actual: colour.r
    expected: 15
  - actual: colour.g
    expected: 15
  - actual: colour.b
    expected: 0
  - actual: checksum
    expected: 72
  - actual: checksum_expected
    expected: 72
