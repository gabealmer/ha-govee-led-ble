# Brightness Gradient: the Gradient tab tapped and re-applied with every other control untouched. Isolates layer_flags bit 0x02, which the spec previously carried as unattributed. Bit 0x10 is set in BOTH, since neither Apply followed a Save.
id: scene_body_brightness_gradient
data: scene_body_brightness_gradient.bin
imports:
  - scene_body
asserts:
  - actual: scene_type
    expected: 2
  - actual: record_count
    expected: 1
  - actual: records.size
    expected: 1
  - actual: padding.size
    expected: 0
  - actual: records[0].rec_len
    expected: 29
  - actual: records[0].body.select_type
    expected: 1
  - actual: records[0].body.colour_count
    expected: 2
  - actual: records[0].body.excess.size
    expected: 0
  - actual: records[0].body.layer_flags
    expected: 18
  - actual: records[0].body.brightness_is_gradient
    expected: true
  - actual: records[0].body.applied_from_changed_editor
    expected: true
