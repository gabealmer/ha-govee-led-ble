# Overall speed 72% -> 34%, 0xb7 -> 0x56. round(0.337 * 255) = 86, where round(34 * 2.55)
# would be 87, so the app percent is a separate rounding and the byte follows the fraction.
id: workshop_body_mv_overall_speed34
data: workshop_body_mv_overall_speed34.bin
imports:
  - workshop_body
asserts:
  - actual: header.linecount
    expected: 4
  - actual: layer_count
    expected: 2
  - actual: layers.size
    expected: 2
  - actual: layers[0].record_len
    expected: 29
  - actual: layers[0].body.colour_count
    expected: 2
  - actual: layers[0].body.palette.size
    expected: 2
  - actual: layers[0].body.excess.size
    expected: 0
  - actual: layers[1].record_len
    expected: 26
  - actual: layers[1].body.colour_count
    expected: 1
  - actual: layers[1].body.palette.size
    expected: 1
  - actual: layers[1].body.excess.size
    expected: 0
  - actual: layers[0].body.overall_movement.speed
    expected: 86
  - actual: layers[0].body.overall_movement.interval
    expected: 1
