# Activation emitted when the app regenerated the AI response.
id: h6199_scene_ai_regenerated_apply
data: h6199_scene_ai_regenerated_apply.bin
imports: [h6199_command_write]
asserts:
  - {actual: opcode, expected: 5}
  - {actual: body.sub_mode, expected: 4}
  - {actual: body.detail.scene_id, expected: 34}
  - {actual: body.detail.scene_class, expected: 0}
