# The same relative-tail proof on Separation.
id: music_body_separation_count7
data: music_body_separation_count7.bin
imports:
  - music_body
asserts:
  - actual: mode
    expected: 50
  - actual: count
    expected: 7
  - actual: palette.size
    expected: 7
  - actual: tail_len
    expected: 3
  - actual: tail.point
    expected: 3
  - actual: tail.gradient
    expected: 0
  - actual: tail.companion
    expected: 97
