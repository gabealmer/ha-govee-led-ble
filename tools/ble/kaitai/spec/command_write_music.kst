# Music mode with a manual colour. manual_color_count 1 is what makes the rgb triple
# present, so the count is a real length prefix rather than a flag.
id: command_write_music
data: command_write_music.bin
imports:
  - command_write
asserts:
  - actual: body.sub
    expected: 19
  - actual: body.sub_body.mode_id
    expected: 3
  - actual: body.sub_body.sensitivity
    expected: 99
  - actual: body.sub_body.style
    expected: 0
  - actual: body.sub_body.manual_color_count
    expected: 1
  - actual: body.sub_body.rgb.r
    expected: 0
  - actual: body.sub_body.rgb.g
    expected: 230
  - actual: body.sub_body.rgb.b
    expected: 210
