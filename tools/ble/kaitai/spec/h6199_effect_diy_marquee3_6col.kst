# H6199 DIY effect uploaded over 0xA3, captured 2026-08-04 from the Govee Home iOS app
# driving the DreamView T1. Marquee3 after deleting the purple swatch, so its pair with marquee3 isolates the palette length and shows exactly that colour's three bytes leave.
id: h6199_effect_diy_marquee3_6col
data: h6199_effect_diy_marquee3_6col.bin
imports:
  - h6199_effect_upload
asserts:
  - actual: chunk_count
    expected: 2
  - actual: kind
    expected: 4
  - actual: content.family
    expected: 3
  - actual: content.variant
    expected: 5
  - actual: content.speed
    expected: 92
  - actual: content.palette_len
    expected: 18
  - actual: content.palette.size
    expected: 6
  - actual: content.palette[0].red
    expected: 255
  - actual: content.palette[0].green
    expected: 0
  - actual: content.palette[3].green
    expected: 255
  - actual: content.padding
    expected: "000000000000000000"
