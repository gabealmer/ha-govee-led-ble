# Wake timer: 17:01, ramp to 100 per cent over 29 minutes, repeat 0 = one-time.
id: command_write_timer_wake
data: command_write_timer_wake.bin
imports:
  - command_write
asserts:
  - actual: body.enabled
    expected: 1
  - actual: body.end_brightness
    expected: 100
  - actual: body.hour
    expected: 17
  - actual: body.minute
    expected: 1
  - actual: body.duration_minutes
    expected: 29
  - actual: body.repeat
    expected: 0
