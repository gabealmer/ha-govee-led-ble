# H6199 relative-brightness write captured 2026-08-05 from the Govee Home iOS
# app driving the DreamView T1. Every edge was deselected, then ONLY the top
# edge was selected and its slider was dragged from 91% to 20%.
id: h6199_relbright_top_20
data: h6199_relbright_top_20.bin
imports:
  - h6199_command_write
asserts:
  - actual: body.left_percent
    expected: 91
  - actual: body.top_percent
    expected: 20
  - actual: body.right_percent
    expected: 91
  - actual: body.bottom_percent
    expected: 91
