# Red at mid amplitude.
id: music_stream_red_mid
data: music_stream_red_mid.bin
imports:
  - music_stream
asserts:
  - actual: colour.r
    expected: 128
  - actual: colour.g
    expected: 0
  - actual: colour.b
    expected: 0
  - actual: checksum
    expected: 170
  - actual: checksum_expected
    expected: 170
