# Violet, the 8b00ff family, at full amplitude.
id: music_stream_violet_full
data: music_stream_violet_full.bin
imports:
  - music_stream
asserts:
  - actual: colour.r
    expected: 138
  - actual: colour.g
    expected: 0
  - actual: colour.b
    expected: 254
  - actual: checksum
    expected: 178
  - actual: checksum_expected
    expected: 178
