# H6199 relative-brightness read-back while all four edges displayed 91%.
id: h6199_status_relative_brightness_91
data: h6199_status_relative_brightness_91.bin
imports:
  - h6199_status_reply
asserts:
  - actual: body.left_percent
    expected: 91
  - actual: body.top_percent
    expected: 91
  - actual: body.right_percent
    expected: 91
  - actual: body.bottom_percent
    expected: 91
