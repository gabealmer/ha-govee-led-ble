# Slot 2, captured 2026-07-27 (h617a-timer-2026-07-27). The ONLY observation of
# enable_and_type 0x80, enabled with the on-action bit clear, which is what separates the
# two bits of that byte. Asserting only the index would leave the fixture pointless.
id: command_write_timer_schedule_off_action
data: command_write_timer_schedule_off_action.bin
imports:
  - command_write
asserts:
  - actual: body.index
    expected: 2
  - actual: body.slot.enable_and_type
    expected: 128
  - actual: body.slot.hour
    expected: 0
  - actual: body.slot.minute
    expected: 0
  - actual: body.slot.repeat
    expected: 128
