id: music_frame_rolling_c1_sens50
data: music_frame_rolling_c1_sens50.bin
imports:
  - music_body
type: mode_set_frame
asserts:
  - actual: mode
    expected: 6
  - actual: sensitivity
    expected: 50
  - actual: style
    expected: 0
  - actual: count
    expected: 1
  - actual: colors.size
    expected: 1
  - actual: colors[0].r
    expected: 255
  - actual: colors[0].g
    expected: 0
  - actual: colors[0].b
    expected: 0
