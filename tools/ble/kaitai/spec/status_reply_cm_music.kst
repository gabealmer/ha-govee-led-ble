# Colour-mode read-back, music, shared govee_common::music_selector. manual_color_count 1
# is what makes the rgb triple meaningful.
id: status_reply_cm_music
data: status_reply_cm_music.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 5
  - actual: body.mode
    expected: 19
  - actual: body.mode_body.mode_id
    expected: 6
  - actual: body.mode_body.sensitivity
    expected: 99
  - actual: body.mode_body.style
    expected: 0
  - actual: body.mode_body.manual_color_count
    expected: 1
  - actual: body.mode_body.rgb.r
    expected: 255
  - actual: body.mode_body.rgb.g
    expected: 0
  - actual: body.mode_body.rgb.b
    expected: 0
