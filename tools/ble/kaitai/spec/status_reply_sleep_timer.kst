# aa 11 sleep timer, shared govee_common::sleep_timer.
id: status_reply_sleep_timer
data: status_reply_sleep_timer.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 17
  - actual: body.enabled
    expected: 0
  - actual: body.start_brightness
    expected: 50
  - actual: body.close_minutes
    expected: 16
  - actual: body.current_minutes
    expected: 16
