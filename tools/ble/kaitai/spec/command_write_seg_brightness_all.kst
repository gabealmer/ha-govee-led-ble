# Whole-strip per-segment relative brightness, static_sub 0x03: no mask at all, one byte
# per segment instead. Captured 2026-07-27 as the last write of a per-segment snapshot
# restore (drive3-static03), segment 1 at 31% and segment 3 at 67% isolated by a
# single-segment differential, the rest at 100%. The 15 entries are what tie this field
# to the segment count.
id: command_write_seg_brightness_all
data: command_write_seg_brightness_all.bin
imports:
  - command_write
asserts:
  - actual: body.sub
    expected: 21
  - actual: body.sub_body.static_sub
    expected: 3
  - actual: body.sub_body.static_body.segment_percent.size
    expected: 15
  - actual: body.sub_body.static_body.segment_percent[0]
    expected: 31
  - actual: body.sub_body.static_body.segment_percent[1]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[2]
    expected: 67
  - actual: body.sub_body.static_body.segment_percent[3]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[4]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[5]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[6]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[7]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[8]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[9]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[10]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[11]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[12]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[13]
    expected: 100
  - actual: body.sub_body.static_body.segment_percent[14]
    expected: 100
