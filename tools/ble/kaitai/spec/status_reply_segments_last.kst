# aa a5 group 5, the last group inside the colour region. Three DIFFERENT colours, unlike
# group 1 above, so the three records are per-segment rather than one value repeated.
# Group 6 and beyond answer with non-colour data and are the reject fixtures below, which
# is how the region boundary was established.
id: status_reply_segments_last
data: status_reply_segments_last.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 165
  - actual: body.group
    expected: 5
  - actual: body.segments[0].colour.r
    expected: 165
  - actual: body.segments[1].colour.r
    expected: 210
  - actual: body.segments[1].colour.g
    expected: 120
  - actual: body.segments[2].colour.b
    expected: 225
