# Piano Keys with 8 keys and gradient on. derived_half tracks key_count // 2, which the
# 15-key body below confirms at 7; live 2026-07-23.
id: music_body_piano_keys_k8_grad1
data: music_body_piano_keys_k8_grad1.bin
imports:
  - music_body
asserts:
  - actual: mode
    expected: 52
  - actual: count
    expected: 7
  - actual: palette.size
    expected: 7
  - actual: tail_len
    expected: 5
  - actual: tail.gradient
    expected: 1
  - actual: tail.key_count
    expected: 8
  - actual: tail.fixed
    expected: "0a04"
  - actual: tail.derived_half
    expected: 4
