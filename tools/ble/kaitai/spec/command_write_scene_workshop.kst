# Workshop activation, code 0x0191. The only H617A activation observed using scene_type
# 0x02, which is the whole reason this fixture sits beside the ordinary scene above: the
# type byte is a real field and not a constant.
id: command_write_scene_workshop
data: command_write_scene_workshop.bin
imports:
  - command_write
asserts:
  - actual: body.sub
    expected: 4
  - actual: body.sub_body.code
    expected: 401
  - actual: body.sub_body.scene_type
    expected: 2
