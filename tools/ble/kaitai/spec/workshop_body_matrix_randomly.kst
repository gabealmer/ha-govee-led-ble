# Select-type matrix, Select IC Randomly.
id: workshop_body_matrix_randomly
data: workshop_body_matrix_randomly.bin
imports:
  - workshop_body
asserts:
  - actual: header.linecount
    expected: 2
  - actual: layer_count
    expected: 1
  - actual: layers.size
    expected: 1
  - actual: layers[0].record_len
    expected: 29
  - actual: layers[0].body.colour_count
    expected: 2
  - actual: layers[0].body.palette.size
    expected: 2
  - actual: layers[0].body.excess.size
    expected: 0
  - actual: layers[0].body.select_type
    expected: 2
  - actual: layers[0].body.select_param_1
    expected: 15
  - actual: layers[0].body.select_param_2
    expected: 1
