# H6199 white-balance read-back after Reset: reset reference and current state are both 16/3.
id: h6199_status_white_balance_reset
data: h6199_status_white_balance_reset.bin
imports:
  - h6199_status_reply
asserts:
  - actual: body.payload.reset_red
    expected: 16
  - actual: body.payload.reset_blue
    expected: 3
  - actual: body.payload.current_red
    expected: 16
  - actual: body.payload.current_blue
    expected: 3
