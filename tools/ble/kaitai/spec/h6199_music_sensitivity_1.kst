# H6199 music-mode write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE, with the Sensitivity slider dragged hard to the bottom of its travel. It stops at 1, not 0, which is what rules out our own 0..100 reading.
id: h6199_music_sensitivity_1
data: h6199_music_sensitivity_1.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 19
  - actual: body.detail.mode
    expected: 3
  - actual: body.detail.sensitivity
    expected: 1
  - actual: body.detail.is_calm
    expected: 0
  - actual: body.detail.has_fixed_colour
    expected: 1
  - actual: body.detail.opaque_tail
    expected: "000000000000000000"
