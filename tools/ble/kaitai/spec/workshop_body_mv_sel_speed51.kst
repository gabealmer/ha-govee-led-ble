# Selected-area speed 94% -> 51%, 0xef -> 0x82. The byte is the slider fraction scaled over
# the full 0x00..0xff range, round(0.5098 * 255) = 130, NOT round(pct * 2.55).
id: workshop_body_mv_sel_speed51
data: workshop_body_mv_sel_speed51.bin
imports:
  - workshop_body
asserts:
  - actual: header.linecount
    expected: 4
  - actual: layer_count
    expected: 2
  - actual: layers.size
    expected: 2
  - actual: layers[0].record_len
    expected: 29
  - actual: layers[0].body.colour_count
    expected: 2
  - actual: layers[0].body.palette.size
    expected: 2
  - actual: layers[0].body.excess.size
    expected: 0
  - actual: layers[1].record_len
    expected: 26
  - actual: layers[1].body.colour_count
    expected: 1
  - actual: layers[1].body.palette.size
    expected: 1
  - actual: layers[1].body.excess.size
    expected: 0
  - actual: layers[0].body.selected_area_movement.interval
    expected: 2
  - actual: layers[0].body.selected_area_movement.speed
    expected: 130
