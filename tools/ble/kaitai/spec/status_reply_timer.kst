# aa 23 schedule table: a 0xff marker then four positional 4-byte slots. Slot 0 was the
# one whose app-side state was known when captured: 07:30 enabled with the on-action bit
# set, repeat 0xc0.
id: status_reply_timer
data: status_reply_timer.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 35
  - actual: body.slots.size
    expected: 4
  - actual: body.slots[0].enable_and_type
    expected: 129
  - actual: body.slots[0].hour
    expected: 7
  - actual: body.slots[0].minute
    expected: 30
  - actual: body.slots[0].repeat
    expected: 192
