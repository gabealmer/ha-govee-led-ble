# aa a5 group 1: three 4-byte <brightness><R><G><B> records.
id: status_reply_segments
data: status_reply_segments.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 165
  - actual: body.group
    expected: 1
  - actual: body.segments.size
    expected: 3
  - actual: body.segments[0].brightness
    expected: 100
  - actual: body.segments[0].colour.r
    expected: 255
  - actual: body.segments[0].colour.g
    expected: 136
  - actual: body.segments[0].colour.b
    expected: 13
  - actual: body.segments[2].colour.r
    expected: 255
