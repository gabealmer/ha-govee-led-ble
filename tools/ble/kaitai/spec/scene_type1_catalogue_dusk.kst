# Vendor catalogue param "dusk", frozen 2026-07-27 from the keyless light-effect-libraries endpoint via fetch_effect_library.py. Evidence about the catalogue FORMAT, not about any device's behaviour.
id: scene_type1_catalogue_dusk
data: scene_type1_catalogue_dusk.bin
imports:
  - scene_type1_body
asserts:
  - actual: scene_type
    expected: 1
  - actual: step_count
    expected: 1
  - actual: steps.size
    expected: 1
  - actual: palette_count
    expected: 2
  - actual: palette.size
    expected: 2
  - actual: padding.size
    expected: 17
  - actual: palette[0].r
    expected: 255
  - actual: palette[0].g
    expected: 0
  - actual: palette[0].b
    expected: 0
  - actual: palette[1].r
    expected: 255
  - actual: palette[1].g
    expected: 127
  - actual: palette[1].b
    expected: 0
