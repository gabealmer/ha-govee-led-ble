# Select-type matrix, Segment. Identical to the baseline outside r2:r4, see the
# differential below.
id: workshop_body_matrix_segment
data: workshop_body_matrix_segment.bin
imports:
  - workshop_body
asserts:
  - actual: header.linecount
    expected: 2
  - actual: layer_count
    expected: 1
  - actual: layers.size
    expected: 1
  - actual: layers[0].record_len
    expected: 29
  - actual: layers[0].body.colour_count
    expected: 2
  - actual: layers[0].body.palette.size
    expected: 2
  - actual: layers[0].body.excess.size
    expected: 0
  - actual: layers[0].body.select_type
    expected: 0
  - actual: layers[0].body.select_param_1
    expected: 0
  - actual: layers[0].body.select_param_2
    expected: 7
