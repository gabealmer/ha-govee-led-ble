# The one distinct aa a3 reply in the corpus: 35 frames across 26 captures, all flag 0x00,
# because the app only ever writes 0x00. The crafted 33 a3 01 probe (2026-07-27c) read
# back 0x01 here, which is what proves the field is live state and not a constant, and is
# why this domain is modelled rather than left raw.
id: status_reply_multi_effect
data: status_reply_multi_effect.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 163
  - actual: body.flag
    expected: 0
