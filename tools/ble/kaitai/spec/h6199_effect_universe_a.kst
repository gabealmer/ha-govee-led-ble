# H6199 effect definition uploaded over 0xA3, captured 2026-08-04 from the Govee Home iOS
# app driving the DreamView T1. Sent immediately before the 33 05 04 write that applies the
# "Universe A" scene from the Natural row. The light was off
# Govee's cloud, so the app reached it by no path but this one, and the PHONE was online,
# which is what made the cloud-backed gallery usable at all.
id: h6199_effect_universe_a
data: h6199_effect_universe_a.bin
imports:
  - h6199_effect_upload
asserts:
  - actual: chunk_count
    expected: 7
  - actual: opaque_kind
    expected: "02"
  - actual: block_count
    expected: 3
  - actual: blocks.size
    expected: 3
  - actual: blocks[0].len
    expected: 35
  - actual: blocks[1].len
    expected: 35
  - actual: blocks[2].len
    expected: 26
  - actual: padding
    expected: "00000000000000000000000000000000"
