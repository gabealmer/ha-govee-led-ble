# Piano Keys at the maximum 15 keys, derived_half 7. Came back byte-identical in the
# 2026-07-27 re-capture, independently re-validating the original transcription.
id: music_body_piano_keys_k15_grad1
data: music_body_piano_keys_k15_grad1.bin
imports:
  - music_body
asserts:
  - actual: mode
    expected: 52
  - actual: count
    expected: 7
  - actual: palette.size
    expected: 7
  - actual: tail_len
    expected: 5
  - actual: tail.gradient
    expected: 1
  - actual: tail.key_count
    expected: 15
  - actual: tail.fixed
    expected: "0a04"
  - actual: tail.derived_half
    expected: 7
