# Live direct read after the vendor app connected with the phone on Australia/Adelaide.
id: status_reply_clock_group32_adelaide
data: status_reply_clock_group32_adelaide.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 165
  - actual: body.group
    expected: 50
  - actual: body.clock.utc_offset_hours
    expected: 9
  - actual: body.clock.utc_offset_minutes
    expected: 30
