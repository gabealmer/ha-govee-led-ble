# Sketch with a MERGED group: seg_count 4 over sparse indices 0, 1, 2 and 4. Extracted from a capture no longer in the archive.
id: diy_type03_anchor_sketch_merged
data: diy_type03_anchor_sketch_merged.bin
imports:
  - diy_type03
asserts:
  - actual: header.linecount
    expected: 2
  - actual: effect
    expected: 9
  - actual: speed
    expected: 51
  - actual: brightness
    expected: 100
  - actual: background.r
    expected: 0
  - actual: background.g
    expected: 0
  - actual: background.b
    expected: 255
  - actual: group_count
    expected: 1
  - actual: groups.size
    expected: 1
  - actual: groups[0].seg_count
    expected: 4
  - actual: groups[0].segment_indices.size
    expected: 4
