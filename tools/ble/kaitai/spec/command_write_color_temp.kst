# Colour temperature, same static_color layout as the RGB case with the roles swapped:
# rgb_direct zeroed, kelvin populated, and the preview triple carrying the app's own
# rendering of that temperature. Holding both cases is what proves the layout is one
# structure rather than two, since a per-mode layout would not need the zeroed halves.
id: command_write_color_temp
data: command_write_color_temp.bin
imports:
  - command_write
asserts:
  - actual: body.sub
    expected: 21
  - actual: body.sub_body.static_sub
    expected: 1
  - actual: body.sub_body.static_body.rgb_direct.r
    expected: 0
  - actual: body.sub_body.static_body.rgb_direct.g
    expected: 0
  - actual: body.sub_body.static_body.rgb_direct.b
    expected: 0
  - actual: body.sub_body.static_body.kelvin
    expected: 3600
  - actual: body.sub_body.static_body.rgb_preview.r
    expected: 255
  - actual: body.sub_body.static_body.rgb_preview.g
    expected: 203
  - actual: body.sub_body.static_body.rgb_preview.b
    expected: 141
  - actual: body.sub_body.static_body.mask.bits
    expected: 32767
