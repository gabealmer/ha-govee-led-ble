# Selected-area movement packed 0x16: enable, enter-exit effect and direction 2 all read
# out of one byte.
id: workshop_body_selected_movement_dir
data: workshop_body_selected_movement_dir.bin
imports:
  - workshop_body
asserts:
  - actual: header.linecount
    expected: 4
  - actual: layer_count
    expected: 2
  - actual: layers.size
    expected: 2
  - actual: layers[0].record_len
    expected: 29
  - actual: layers[0].body.colour_count
    expected: 2
  - actual: layers[0].body.palette.size
    expected: 2
  - actual: layers[0].body.excess.size
    expected: 0
  - actual: layers[1].record_len
    expected: 26
  - actual: layers[1].body.colour_count
    expected: 1
  - actual: layers[1].body.palette.size
    expected: 1
  - actual: layers[1].body.excess.size
    expected: 0
  - actual: layers[0].body.selected_area_movement.packed
    expected: 22
  - actual: layers[0].body.selected_area_movement.enabled
    expected: true
  - actual: layers[0].body.selected_area_movement.enter_exit_effect
    expected: true
  - actual: layers[0].body.selected_area_movement.direction
    expected: 2
  - actual: layers[0].body.priority
    expected: 1
