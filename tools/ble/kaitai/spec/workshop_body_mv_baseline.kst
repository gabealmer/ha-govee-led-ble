# Start of the 2026-07-23 single-slider chain on Moving Christmas L1: baseline -> selected
# interval -> selected speed -> overall speed -> overall interval. Each Apply moved exactly
# one tail byte, and the differentials below are the whole point of the series.
id: workshop_body_mv_baseline
data: workshop_body_mv_baseline.bin
imports:
  - workshop_body
asserts:
  - actual: header.linecount
    expected: 4
  - actual: layer_count
    expected: 2
  - actual: layers.size
    expected: 2
  - actual: layers[0].record_len
    expected: 29
  - actual: layers[0].body.colour_count
    expected: 2
  - actual: layers[0].body.palette.size
    expected: 2
  - actual: layers[0].body.excess.size
    expected: 0
  - actual: layers[1].record_len
    expected: 26
  - actual: layers[1].body.colour_count
    expected: 1
  - actual: layers[1].body.palette.size
    expected: 1
  - actual: layers[1].body.excess.size
    expected: 0
  - actual: layers[0].body.selected_area_movement.interval
    expected: 1
  - actual: layers[0].body.selected_area_movement.speed
    expected: 239
  - actual: layers[0].body.overall_movement.interval
    expected: 1
  - actual: layers[0].body.overall_movement.speed
    expected: 183
