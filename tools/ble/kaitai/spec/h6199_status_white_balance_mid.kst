# H6199 white-balance read-back before Reset: reset reference 16/3, current state 13/3.
id: h6199_status_white_balance_mid
data: h6199_status_white_balance_mid.bin
imports:
  - h6199_status_reply
asserts:
  - actual: body.payload.reset_red
    expected: 16
  - actual: body.payload.reset_blue
    expected: 3
  - actual: body.payload.current_red
    expected: 13
  - actual: body.payload.current_blue
    expected: 3
