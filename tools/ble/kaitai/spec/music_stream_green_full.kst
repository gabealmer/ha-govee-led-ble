# Green at full amplitude.
id: music_stream_green_full
data: music_stream_green_full.bin
imports:
  - music_stream
asserts:
  - actual: colour.r
    expected: 0
  - actual: colour.g
    expected: 254
  - actual: colour.b
    expected: 0
  - actual: checksum
    expected: 40
  - actual: checksum_expected
    expected: 40
