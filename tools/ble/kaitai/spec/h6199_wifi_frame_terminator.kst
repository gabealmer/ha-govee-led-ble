# H6199 Wi-Fi provisioning frame, captured 2026-08-04 from the Govee Home iOS app driving the
# DreamView T1 with the phone in Airplane Mode, which is what made the app offer manual SSID
# entry at all. The network is INVENTED: no real credentials are committed here. The same six
# frames were later written back from our own radio and drew the same acknowledgement, so the
# sequence is confirmed from both directions.

id: h6199_wifi_frame_terminator
data: h6199_wifi_frame_terminator.bin
imports:
  - h6199_wifi_provision
asserts:
  - actual: sub_opcode
    expected: 17
  - actual: index
    expected: 255
  - actual: is_terminator
    expected: true
  - actual: payload
    expected: "00000000000000000000000000000000"
