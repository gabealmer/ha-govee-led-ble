# H6199 music-mode write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE, with auto colour off and red chosen from the palette. The light was off Govee's cloud, so BLE was its only
# path. These captures are what showed the body's trailing window was not padding.
id: h6199_music_colour_red
data: h6199_music_colour_red.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 19
  - actual: body.detail.mode
    expected: 3
  - actual: body.detail.sensitivity
    expected: 62
  - actual: body.detail.is_calm
    expected: 0
  - actual: body.detail.has_fixed_colour
    expected: 1
  - actual: body.detail.fixed_colour.red
    expected: 255
  - actual: body.detail.fixed_colour.green
    expected: 0
  - actual: body.detail.fixed_colour.blue
    expected: 0
  - actual: body.detail.opaque_tail
    expected: "000000000000000000"
