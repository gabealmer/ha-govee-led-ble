# H6199 white-balance read-back at the warm endpoint: reference 16/3, current 21/5.
id: h6199_status_white_balance_warm
data: h6199_status_white_balance_warm.bin
imports:
  - h6199_status_reply
asserts:
  - actual: body.payload.reset_red
    expected: 16
  - actual: body.payload.reset_blue
    expected: 3
  - actual: body.payload.current_red
    expected: 21
  - actual: body.payload.current_blue
    expected: 5
