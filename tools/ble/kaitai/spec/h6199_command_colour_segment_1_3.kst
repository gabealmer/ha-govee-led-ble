# H6199 static-colour write addressing both of those segments together, captured 2026-08-03 from the Govee Home iOS
# app driving the DreamView T1 over BLE with the phone in Airplane Mode. Taken in one
# session from the Color tab's Subsection view by holding the colour at red and changing
# only which segments were ticked, so the mask is the sole variable across the three.
id: h6199_command_colour_segment_1_3
data: h6199_command_colour_segment_1_3.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 21
  - actual: body.detail.opaque_head
    expected: "01"
  - actual: body.detail.red
    expected: 255
  - actual: body.detail.green
    expected: 0
  - actual: body.detail.blue
    expected: 0
  - actual: body.detail.opaque_gap
    expected: "0000000000"
  - actual: body.detail.segment_mask
    expected: 5
  - actual: body.detail.opaque_tail
    expected: "0000000000"
