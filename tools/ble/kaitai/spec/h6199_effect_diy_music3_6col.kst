# The same H6199 Music3 effect after shortening the palette to six colours.
id: h6199_effect_diy_music3_6col
data: h6199_effect_diy_music3_6col.bin
imports: [h6199_effect_upload]
asserts:
  - {actual: kind, expected: 4}
  - {actual: content.family, expected: 4}
  - {actual: content.variant, expected: 7}
  - {actual: content.speed, expected: 50}
  - {actual: content.palette_len, expected: 18}
  - {actual: content.palette.size, expected: 6}
