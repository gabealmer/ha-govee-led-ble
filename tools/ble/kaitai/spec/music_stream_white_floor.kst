# White at the floor, all three channels equal.
id: music_stream_white_floor
data: music_stream_white_floor.bin
imports:
  - music_stream
asserts:
  - actual: colour.r
    expected: 12
  - actual: colour.g
    expected: 12
  - actual: colour.b
    expected: 12
  - actual: checksum
    expected: 78
  - actual: checksum_expected
    expected: 78
