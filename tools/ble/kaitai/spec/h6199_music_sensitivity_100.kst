# H6199 music-mode write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE, with the Sensitivity slider dragged hard to the top of its travel. 100 is the value that rules out the vendor Android app's 0..99 clamp applying to this app.
id: h6199_music_sensitivity_100
data: h6199_music_sensitivity_100.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 19
  - actual: body.detail.mode
    expected: 3
  - actual: body.detail.sensitivity
    expected: 100
  - actual: body.detail.is_calm
    expected: 0
  - actual: body.detail.has_fixed_colour
    expected: 1
  - actual: body.detail.opaque_tail
    expected: "000000000000000000"
