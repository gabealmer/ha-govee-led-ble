# aa 40 reply, count 15 on the H617A. What the 15 counts is not settled and the field is
# named "count" for that reason: see unit_count_body, which records that the app-segment
# reading is positively excluded on two other models.
id: status_reply_unit_count
data: status_reply_unit_count.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 64
  - actual: body.reserved
    expected: 0
  - actual: body.count
    expected: 15
