# Effects Lab Brightness Order B, the same scene re-applied with only Brightness Order moved from Brightest-Darkest to Darkest-Brightest-Darkest.
id: scene_body_brightness_order_b
data: scene_body_brightness_order_b.bin
imports:
  - scene_body
asserts:
  - actual: scene_type
    expected: 2
  - actual: record_count
    expected: 1
  - actual: records.size
    expected: 1
  - actual: padding.size
    expected: 0
  - actual: records[0].rec_len
    expected: 29
  - actual: records[0].body.select_type
    expected: 1
  - actual: records[0].body.colour_count
    expected: 2
  - actual: records[0].body.excess.size
    expected: 0
  - actual: records[0].body.brightness_blocks[0].brightness_order
    expected: 3
