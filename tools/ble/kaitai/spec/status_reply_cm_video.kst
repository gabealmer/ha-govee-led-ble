# Colour-mode read-back, video. Mode 0x00 with an opaque payload: deliberately unmodelled
# rather than guessed. NOTE the direction trap, which has bitten twice: the aa 05 QUERY
# body is byte-identical to a mode 0x00 video reply, so a direction-blind scan reports
# phantom video mode.
id: status_reply_cm_video
data: status_reply_cm_video.bin
imports:
  - status_reply
asserts:
  - actual: domain
    expected: 5
  - actual: body.mode
    expected: 0
  - actual: body.mode_body.opaque
    expected: "00014d00000000000000000000000000"
