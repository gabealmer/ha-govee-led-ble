# NOT a single-byte A/B. This differs from bloom_c0_calm in sensitivity AND style, so it
# pins the pair rather than either byte. Recorded as such: see the differential below,
# which claims exactly two payload bytes rather than one.
id: music_frame_bloom_c0_sens50_dynamic
data: music_frame_bloom_c0_sens50_dynamic.bin
imports:
  - music_body
type: mode_set_frame
asserts:
  - actual: mode
    expected: 48
  - actual: sensitivity
    expected: 50
  - actual: style
    expected: 0
  - actual: count
    expected: 0
  - actual: colors.size
    expected: 0
